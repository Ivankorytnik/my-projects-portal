<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="БАРАХОЛКА · ОЦЕНКА ПО ФОТО"
            android:textColor="#68707D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Оценка по фотографии"
            android:textColor="#15181E"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Сфотографируйте товар. AI распознает предмет, найдет похожие предложения и доступные результаты продаж, затем покажет ориентировочную цену."
            android:textColor="#59616E"
            android:textSize="15sp" />

        <Button
            android:id="@+id/takePhotoButton"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:layout_marginTop="24dp"
            android:text="Сделать фото и оценить"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Готово к работе"
            android:textColor="#59616E"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/valuationPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ОРИЕНТИРОВОЧНАЯ ОЦЕНКА"
                android:textColor="#68707D"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Предмет"
                android:textColor="#15181E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/marketPriceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Рынок: —"
                android:textColor="#15181E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quickPriceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Быстрая продажа: —"
                android:textColor="#59616E"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/buyMaxText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Для перепродажи брать до: —"
                android:textColor="#59616E"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/recommendationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Рекомендация: —"
                android:textColor="#15181E"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/valuationCommentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#59616E"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/checkNextText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#59616E"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/confidenceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#858D98"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Как работает"
                android:textColor="#15181E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="1. AI распознает предмет и его видимое состояние."
                android:textColor="#59616E"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="2. Система ищет похожие предложения и доступные результаты продаж."
                android:textColor="#59616E"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="3. Цена корректируется по рынку и выводится на экран."
                android:textColor="#59616E"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/updateButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:text="Скачать обновление APK"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Откроется загрузка самой свежей версии приложения с Korytnik Hub."
            android:textColor="#858D98"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:paddingBottom="24dp"
            android:text="Оценка ориентировочная и зависит от качества фото, состояния, маркировок и спроса. Для дорогих или редких вещей дополнительно фотографируйте клейма, подписи, размеры, повреждения и комплектность. Фото сохраняется в Pictures/PhotoMarket."
            android:textColor="#858D98"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
