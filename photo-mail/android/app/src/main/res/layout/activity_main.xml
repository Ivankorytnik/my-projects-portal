<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F6F7F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="БАРАХОЛКА · ОЦЕНКА ПО ФОТО"
            android:textColor="#68707D"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Фото + оценка"
            android:textColor="#15181E"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Сделайте фото товара. Приложение отправит снимок на выбранную почту и покажет ориентировочную стоимость на экране."
            android:textColor="#59616E"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Куда отправлять"
            android:textColor="#15181E"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/emailSpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/newEmail"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:hint="Новый email"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="14dp"
                android:singleLine="true"
                android:textColor="#15181E"
                android:textColorHint="#9AA1AC" />

            <Button
                android:id="@+id/saveEmailButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:text="Добавить" />
        </LinearLayout>

        <Button
            android:id="@+id/deleteEmailButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Удалить выбранный адрес" />

        <Button
            android:id="@+id/takePhotoButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="Сделать фото · отправить · оценить"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:indeterminate="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Готово к работе"
            android:textColor="#59616E"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/valuationPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ОРИЕНТИРОВОЧНАЯ ОЦЕНКА"
                android:textColor="#68707D"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Предмет"
                android:textColor="#15181E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/marketPriceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Рынок: —"
                android:textColor="#15181E"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/quickPriceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Быстрая продажа: —"
                android:textColor="#59616E"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/buyMaxText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Для перепродажи брать до: —"
                android:textColor="#59616E"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/recommendationText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Рекомендация: —"
                android:textColor="#15181E"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/valuationCommentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#59616E"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/checkNextText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#59616E"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/confidenceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#858D98"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/settingsToggleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="Настройка почты отправителя" />

        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Настраивается один раз. Используйте пароль приложения, а не основной пароль от почты."
                android:textColor="#59616E"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/senderEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:hint="Почта отправителя"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

            <EditText
                android:id="@+id/senderPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Пароль приложения"
                android:inputType="textPassword"
                android:singleLine="true" />

            <EditText
                android:id="@+id/smtpHost"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="SMTP сервер, например smtp.gmail.com"
                android:inputType="textUri"
                android:singleLine="true" />

            <EditText
                android:id="@+id/smtpPort"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:hint="Порт"
                android:inputType="number"
                android:singleLine="true"
                android:text="465" />

            <Button
                android:id="@+id/saveSenderButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:text="Сохранить настройку почты" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingBottom="24dp"
            android:text="Оценка ориентировочная и зависит от фото, состояния, маркировок и спроса. Для дорогих или редких вещей обязательно проверяйте клейма, размеры, комплектность и реальные продажи. Фото сохраняется в Pictures/PhotoMail."
            android:textColor="#858D98"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
